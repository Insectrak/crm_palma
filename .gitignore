# ============================================================
# .gitignore — Palma CRM (produccion / EasyPanel)
# ============================================================

# ─── Secrets / Credenciales ─────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
client_secret.json
token.json
google_credentials.json
google-services.json

# ─── Entorno local y respaldos ──────────────────────────────
_palma_legacy/
docker-compose.yml
*.dump
*.sql.gz
*.bak
backups/

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
.venv/
venv/
env/
*.egg
.pytest_cache/
.coverage
htmlcov/

# ─── Node / Frontend ────────────────────────────────────────
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDEs y OS ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
