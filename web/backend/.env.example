# ============================================================
# .env.example — CRM multi-tenant (vertical-agnostic)
# Copiar como .env y completar los valores reales del tenant.
# Las variables marcadas (REQUERIDA) no tienen valor por defecto seguro:
# deben configurarse antes de arrancar la app en prod.
# ============================================================

# ─── Base de datos ───────────────────────────────────────────
# PostgreSQL. Formato: postgresql://user:password@host:port/dbname
# Cada tenant tiene su propia DB (multi-tenancy por deployment).
DATABASE_URL=postgresql://postgres:password@<pg-host>:5432/crm_<tenant_slug>
# Tamaño del pool de conexiones (V113). Default: min=4, max=35, timeout=10s.
# Aumentar DB_POOL_MAX_CONN si hay múltiples workers o alta concurrencia.
# DB_POOL_MIN_CONN=4
# DB_POOL_MAX_CONN=35
# DB_POOL_TIMEOUT=10.0

# ─── JWT / Autenticacion ─────────────────────────────────────
# (REQUERIDA) Clave para firmar los tokens JWT.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# ─── CORS ────────────────────────────────────────────────────
# Origenes permitidos para el navegador (separados por coma, sin espacios).
# Multi-tenant: cada deploy (cliente) tiene su lista propia.
# El backend esta hosteado en distintos servidores por cliente, NO comparten DB.
#
# Ejemplo: ALLOWED_ORIGINS=http://localhost:5173,https://crm.<dominio-cliente>.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3002

# URL pública canónica del CRM (sin trailing slash). Si está vacío se deriva
# del primer ALLOWED_ORIGINS que no sea localhost. Se usa para construir
# enlaces absolutos que viajan fuera del CRM (emails de invitación, etc.).
# Gmail bloquea data URLs en <img> → el logo del email se sirve vía este URL.
# Ejemplo Palma: PUBLIC_BASE_URL=https://crm.palmadelrioinmobiliaria.org
# PUBLIC_BASE_URL=

# ─── Branding por tenant (opcional — defaults neutros si no se setean) ──
# Si NO se setean, el branding se carga de public.app_settings (editable
# por el admin desde la UI Configuracion → Marca). NUNCA hardcodear el
# nombre de un cliente especifico en codigo — el CRM es vertical-agnostic.
# TENANT_COMPANY_NAME=<Nombre comercial del cliente>
# TENANT_INDUSTRY=<industria>             # 'inmobiliaria', 'dental', 'hotelero', ...
# TENANT_INDUSTRY_DESC=<descripcion para prompts IA>
# TENANT_KEYWORDS=<csv keywords relevantes>
# TENANT_COUNTRY=Peru
# TENANT_SUPPORT_EMAIL=soporte@<dominio-cliente>.com
# TENANT_KNOWN_DOMAINS=<csv dominios para anti-phishing>

# ─── Modo demo ───────────────────────────────────────────────
# true  = la app funciona sin conectarse a Postgres real (datos ficticios)
# false = produccion normal
DEMO_MODE=false

# ─── n8n (integracion opcional) ──────────────────────────────
# Base URL del contenedor n8n interno (sin trailing slash)
N8N_WEBHOOK_BASE=http://<n8n-host>:5678
# Clave compartida para autenticar webhooks internos hacia n8n.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
N8N_INTERNAL_KEY=cambia_esto_por_una_clave_interna

# ─── Multi-tenant ingest (drivers externos, proveedores IA, Wedo) ───
# Clave que valida las llamadas a POST /api/ingest/leads desde sistemas
# externos. Cada cliente del CRM tiene la suya.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=

# ─── IA: Ollama para mensajes motivacionales (opcional) ──────
# Si OLLAMA_BASE_URL apunta a un Ollama vivo, el dashboard genera
# saludos personalizados al asesor. Vacío = se usan defaults.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b

# ─── Emergency reset (recuperación admin sin login) ──────────
# Si EMERGENCY_SECRET está seteado, el endpoint /api/emergency-reset
# acepta resetear la password del admin (útil cuando se pierde acceso).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Dejar vacío para deshabilitar el endpoint en producción.
EMERGENCY_SECRET=

# ─── URL pública del backend (para callbacks de métricas/SLO) ──
# Usada por workflows de n8n para reportar SLI-5 (backup OK/fail).
# Idealmente la URL canónica con HTTPS.
# CRM_BACKEND_URL=https://crm.<dominio-cliente>.com

# ─── WhatsApp Business Cloud API (Meta — oficial) ────────────
# Modelo MODERNO (V034+): NO setear variables en este .env.
# Configurar las cuentas desde la UI del CRM:
#   Integraciones → WhatsApp → Cuentas Empresariales (WABA)
#   Integraciones → WhatsApp → Líneas WhatsApp Business
# Multi-WABA nativo, multi-línea por WABA, tokens cifrados en DB.
# El backend busca verify_token/app_secret primero en DB; el env solo
# se usa como fallback legacy single-WABA.
#
# Si por alguna razón necesitás modo legacy (ej. migración desde un
# install viejo, o testing), agregá manualmente:
#   META_WA_ACCESS_TOKEN=
#   META_WA_PHONE_NUMBER_ID=
#   META_WA_WEBHOOK_VERIFY_TOKEN=
#   META_WA_APP_SECRET=
#   META_WA_BUSINESS_ACCOUNT_ID=
# Pero NO se recomienda — preferí configurar por WABA en UI.

# ─── Push notifications mobile (Firebase Cloud Messaging) ───
# Ver docs/SETUP_FIREBASE.md para el procedimiento completo.
# FCM_ENABLED=true
# FCM_SERVICE_ACCOUNT_B64=<json del service account en base64>

# ─── Formularios publicos — anti-spam (opcional) ─────────────
# Todas tienen defaults sensatos; descomenta solo si necesitas tunearlas
# por ambiente o para otro pais (country code).
#
# Tiempo minimo en segundos desde que se carga el form hasta el submit.
# Los bots envian en <1s; 2s bloquea la mayoria sin molestar humanos.
# PUBLIC_FORM_MIN_SUBMIT_SECONDS=2
#
# Rate limit por IP a nivel de DB (defensa en profundidad sobre slowapi).
# PUBLIC_FORM_IP_MAX_SUBMISSIONS=5
# PUBLIC_FORM_IP_WINDOW_MINUTES=10
#
# Rate limits de slowapi (en memoria) — formato "N/unit".
# PUBLIC_FORM_RATE_LIMIT_SUBMIT=10/minute
# PUBLIC_FORM_RATE_LIMIT_GET=60/minute
#
# Codigo de pais por defecto cuando el lead escribe el telefono sin
# prefijo. PE=51, CL=56, MX=52, AR=54, CO=57. Sin el signo "+".
# PUBLIC_FORM_DEFAULT_COUNTRY_CODE=51

# ─── Observabilidad / Error tracking (opcional) ──────────────
# Sentry captura excepciones no manejadas y las envia a un dashboard
# externo. Free tier: 5K eventos/mes por proyecto.
#
# Cada cliente del CRM debe usar su propio proyecto Sentry (aislamiento
# de datos por DSN). Si SENTRY_DSN esta vacio, Sentry NO se inicializa.
#
# V070.99 — PII scrubbing automatico antes de enviar (Ley 29733 PE):
#   - Telefonos → ***1234, emails → j**n@dom, DNI → ****5678
#   - Headers Authorization / X-Api-Key / passwords → [REDACTED]
#   - Tag por tenant (host) para filtrar por cliente en el dashboard
#
# OPCION A — GlitchTip self-hosted (RECOMENDADO):
# Cero costo, sin limites de eventos, multi-tenant nativo, data en tu
# servidor (Ley 29733 PE +). Deploy: deploy/glitchtip/README.md
# SENTRY_DSN=https://abc@glitchtip.brighton.com/1
#
# OPCION B — Sentry Cloud free (5K eventos/mes, 1 proyecto):
# Crear proyecto BACKEND: https://sentry.io → New Project → FastAPI
# SENTRY_DSN=https://abc123@sentry.io/1234567
#
# Comun a ambas opciones (mismo SDK):
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0   # 0 = solo errores; 0.1 = 10% traces
#
# Frontend (Vite — vars consumidas en build-time, web/frontend/.env):
# VITE_SENTRY_DSN=https://xyz@glitchtip.brighton.com/2
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1   # 10% interacciones
# VITE_SENTRY_REPLAYS_ON_ERROR_RATE=1.0 # graba 10s pre-crash
# VITE_APP_VERSION=v5.59.2              # idealmente git SHA corto

# Version del codigo deployado (aparece en /api/health).
# Idealmente el SHA corto del commit (CI lo inyecta en el build).
# APP_VERSION=dev

# ─── Observabilidad: Prometheus metrics (V070.72) ────────────
# Endpoint /metrics expone SLIs de los 5 SLOs (ver docs/SLO.md).
# En DEV/CI: dejar METRICS_ENDPOINT_PROTECTED=false (default).
# En PROD: OBLIGATORIO METRICS_ENDPOINT_PROTECTED=true + METRICS_TOKEN
# para no exponer counts/errors por endpoint a observers externos.
# METRICS_ENABLED=true
# METRICS_ENDPOINT_PROTECTED=true
# METRICS_TOKEN=<random 32+ chars hex — generar con secrets.token_hex(32)>
# N8N_INTERNAL_KEY=<random — usado por wf_crm_backup para reportar SLI-5>

# ─── Notas de despliegue ─────────────────────────────────────
# 1. En EasyPanel, definir estas variables en Environment del servicio CRM.
# 2. Rotar SECRET_KEY invalida todas las sesiones activas — hacerlo solo
#    cuando se sospeche compromiso.
# 3. DATABASE_URL debe apuntar a la red interna del stack, nunca al host
#    publico.
# 4. Las variables desconocidas se ignoran en runtime (extra="ignore"),
#    asi que es seguro tener extras de otros proyectos en el mismo .env
#    sin que la app falle al arrancar.
# 5. Para Tailscale + off-site backup, configurar las env vars
#    BACKUP_OFFSITE_* en el n8n del cliente, NO aqui — ver
#    docs/SETUP_TAILSCALE.md.
